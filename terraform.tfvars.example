# AWS Configuration
aws_region = "ap-south-1"

# Project Configuration
environment = "prod"
project_name = "myapp"

# Instance Configuration
instance_count = 2
instance_type  = "t3.medium"

# AMI Configuration (Amazon Linux 2023)
ami_owner         = "amazon"
ami_name_pattern  = "al2023-ami-*"

# Storage Configuration
root_volume_size      = 50
root_volume_type      = "gp3"
root_volume_iops      = 3000
root_volume_throughput = 125

# VPC and Networking
vpc_name = "default"
subnet_tags = {
  Type = "Public"
}

# Security Configuration
key_pair_name              = "my-ec2-keypair"
allowed_ssh_cidrs          = ["10.0.0.0/8", "203.0.113.0/24"]  # Private IP ranges
allowed_http_cidrs         = ["0.0.0.0/0"]
allowed_https_cidrs        = ["0.0.0.0/0"]
associate_public_ip        = false
enable_termination_protection = true

# Monitoring and Performance
enable_monitoring    = true
enable_ebs_optimized = true
enable_auto_recovery = true

# IAM Configuration
iam_instance_profile = null  # Optional: specify IAM role for EC2

# Custom User Data (optional)
user_data = null  # Uses default CloudWatch configuration if null

# Additional Tags
additional_tags = {
  CostCenter = "Engineering"
  Owner      = "DevOps Team"
  Backup     = "daily"
}
